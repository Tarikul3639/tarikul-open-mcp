generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model McpOauthClient {
  clientId      String                 @id @map("client_id")
  clientSecret  String?                @map("client_secret")
  redirectUris  Json                   @default("[]") @map("redirect_uris")
  clientName    String?                @map("client_name")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  grants        McpOauthGrant[]
  codes         McpAuthorizationCode[]
  refreshTokens McpRefreshToken[]

  @@map("mcp_oauth_clients")
}

model McpOauthGrant {
  userId    String         @map("user_id")
  clientId  String         @map("client_id")
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime?      @map("revoked_at") @db.Timestamptz(6)
  client    McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@id([userId, clientId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("mcp_oauth_grants")
}

model McpAuthorizationCode {
  code                String         @id
  clientId            String         @map("client_id")
  redirectUri         String         @map("redirect_uri")
  codeChallenge       String         @map("code_challenge")
  codeChallengeMethod String         @default("S256") @map("code_challenge_method")
  userId              String         @map("user_id")
  expiresAt           DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  client              McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@map("mcp_authorization_codes")
}

model McpRefreshToken {
  tokenHash String         @id @map("token_hash")
  clientId  String         @map("client_id")
  userId    String         @map("user_id")
  familyId  String         @map("family_id")
  expiresAt DateTime?      @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?      @map("used_at") @db.Timestamptz(6)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  client    McpOauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("mcp_refresh_tokens")
}

model GoogleCalendarAccount {
  userId    String   @id @map("user_id")
  tokens    Json
  email     String
  name      String?
  picture   String?
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("google_calendar_accounts")
}
